    { "name": "retention-d7", "metric": "D7Retention", "granularity": "OneDay" },
    { "name": "retention-d30", "metric": "D30Retention", "granularity": "OneDay" },
    { "name": "revenue", "metric": "DailyRevenue", "granularity": "OneDay" },
    { "name": "revenue-total", "metric": "Revenue", "granularity": "OneDay" },
