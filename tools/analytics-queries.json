{
  "_comment": "Queries for tools/fetch-analytics.py (Roblox Open Cloud Analytics Query API, beta). One file per name under docs/analytics/<date>/. A metric name Roblox does not know is reported in summary.md and skipped; fix or remove it here. Docs: docs/ANALYTICS.md.",
  "queries": [
    { "name": "dau", "metric": "DailyActiveUsers", "granularity": "OneDay" },
    { "name": "dau-by-platform", "metric": "DailyActiveUsers", "granularity": "OneDay", "breakdown": ["Platform"] },
    { "name": "dau-by-country", "metric": "DailyActiveUsers", "granularity": "OneDay", "breakdown": ["Country"] },
    { "name": "mau", "metric": "MonthlyActiveUsers", "granularity": "OneDay" },
    { "name": "new-vs-returning", "metric": "DailyActiveUsers", "granularity": "OneDay", "breakdown": ["IsNewUser"] },
    { "name": "session-length", "metric": "AverageSessionLengthMinutes", "granularity": "OneDay" },
    { "name": "playtime-per-user", "metric": "AveragePlayTimeMinutesPerDAU", "granularity": "OneDay" },
    { "name": "sessions", "metric": "Visits", "granularity": "OneDay" },
    { "name": "retention-d1", "metric": "D1Retention", "granularity": "OneDay" },
    { "name": "retention-d7", "metric": "D7Retention", "granularity": "OneDay" },
    { "name": "retention-d30", "metric": "D30Retention", "granularity": "OneDay" },
    { "name": "revenue", "metric": "DailyRevenue", "granularity": "OneDay" },
    { "name": "paying-users", "metric": "PayingUsers", "granularity": "OneDay" },
    { "name": "revenue-total", "metric": "DailyRevenue", "granularity": "None" },
    { "name": "funnel-users", "metric": "FunnelUserTotalCount", "granularity": "None", "breakdown": ["FunnelName", "FunnelStep"] },
    { "name": "funnel-step-completion", "metric": "FunnelUserStepCompletionRate", "granularity": "None", "breakdown": ["FunnelName", "FunnelStep"] },
    { "name": "custom-events", "metric": "CustomEventCount", "granularity": "None", "breakdown": ["CustomEventName"] },
    { "name": "economy", "metric": "EconomyTransactionAmount", "granularity": "None", "breakdown": ["CurrencyType", "FlowType", "TransactionType"] }
  ]
}
