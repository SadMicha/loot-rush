-- Loading screen (ReplicatedFirst/LootRushLoading, docs/ROADMAP.md O2)
describe("Loading screen", function()
	it("covers the join and fades out once the client preloaded", function()
		sim:boot({ seconds = 0.2 })
		local gui = sim.player.PlayerGui:FindFirstChild("LootRushLoading")
		expect(gui).toBeTruthy()
		sim:run(20)
		expect(sim.player:GetAttribute("PreloadPhase")).toBe("ready")
		expect(sim.player:GetAttribute("PreloadDone")).toBe(sim.player:GetAttribute("PreloadTotal"))
		expect(sim.player:GetAttribute("ClientReady")).toBe(true)
		expect(sim.player.PlayerGui:FindFirstChild("LootRushLoading")).toBeNil()
	end)
end)
