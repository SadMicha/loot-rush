local Format = require("ReplicatedStorage.Shared.Util.Format")

describe("Format.big", function()
	it("keeps small numbers whole", function()
		expect(Format.big(0)).toBe("0")
		expect(Format.big(950)).toBe("950")
		expect(Format.big(999.9)).toBe("999")
	end)

	it("shortens with suffix and decimal point", function()
		expect(Format.big(1000)).toBe("1.0K")
		expect(Format.big(12400)).toBe("12.4K")
		expect(Format.big(3100000)).toBe("3.1M")
		expect(Format.big(870e9)).toBe("870B")
		expect(Format.big(1.2e15)).toBe("1.2aa")
	end)

	it("stays at the largest suffix", function()
		expect(Format.big(1e40)).toMatch("ae$")
	end)
end)

describe("Format.int", function()
	it("adds thousands commas", function()
		expect(Format.int(0)).toBe("0")
		expect(Format.int(999)).toBe("999")
		expect(Format.int(1240)).toBe("1,240")
		expect(Format.int(1234567)).toBe("1,234,567")
	end)
end)

describe("Format.currency", function()
	it("keeps amounts below 1,000 whole", function()
		expect(Format.currency(0)).toBe("0")
		expect(Format.currency(300)).toBe("300")
		expect(Format.currency(999.9)).toBe("999")
		expect(Format.currency(-25)).toBe("-25")
		expect(Format.currency(0 / 0)).toBe("0")
	end)

	it("is compact above, without a trailing .0", function()
		expect(Format.currency(1000)).toBe("1K")
		expect(Format.currency(1200)).toBe("1.2K")
		expect(Format.currency(2300)).toBe("2.3K")
		expect(Format.currency(8100)).toBe("8.1K")
		expect(Format.currency(11000)).toBe("11K")
		expect(Format.currency(250000)).toBe("250K")
		expect(Format.currency(1192509)).toBe("1.2M") -- the shop header showed "1,192,509"
		expect(Format.currency(1200000)).toBe("1.2M")
		expect(Format.currency(3.44e9)).toBe("3.4B")
		expect(Format.currency(870e9)).toBe("870B")
	end)
end)
